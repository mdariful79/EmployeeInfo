@page "/Tab"
@using Domain.Models;
@* <style>
    .custom-stepper {
        display: flex;
        justify-content: space-between;
    }

</style> *@

<PageRF Title="Application Form Dashboard">
    

    <FormRF @ref=formRF Model="Training" OnAfterSave=afterSave>
        <TabRF OnNext="next" OnClose="close"
               OnPrev="prev" StepperFooter=true Stepper=true>
            <TabHeader>
                <TabHeaderRF Horizontal=false TextSize="calc(10px + 1vw);" Text="Event Details" Icon="fa-solid fa-1" IconSize="calc(10px + 1vw);" />
            </TabHeader>
            <TabBody>
                <RowRF>

                    <ColRF SpanSM="12" Span="3" SpanL="3" SpanXL="3">
                        <InputRF @bind-Value="@context.CategoryId" Label="CategoryId" Placeholder="Enter Category id" />
                    </ColRF>
                   

                </RowRF>


            </TabBody>
            <TabHeader>
                <TabHeaderRF Horizontal=false TextSize="calc(10px + 1vw);" Text="Funding Info" Icon="fa-solid fa-2" IconSize="calc(10px + 1vw);" />
            </TabHeader>
            <TabBody>
                <RowRF>

                    <ColRF SpanSM="12" Span="3" SpanL="3" SpanXL="3">
                        <InputRF @bind-Value="@context.TrainingName" Label="TrainingName" Placeholder="Enter Training Name" />
                    </ColRF>


                </RowRF>
            </TabBody>
            <TabHeader>
                <TabHeaderRF Horizontal=false TextSize="calc(10px + 1vw);" Text="Risk Assessment" Icon="fa-solid fa-3" IconSize="calc(10px + 1vw);" />
            </TabHeader>
            <TabBody>
                <RowRF>

                    <ColRF SpanSM="12" Span="3" SpanL="3" SpanXL="3">
                        <InputRF @bind-Value="@context.EmployeesId" Label="EmployeesId" Placeholder="Enter EmployeesId" />
                    </ColRF>


                </RowRF>
            </TabBody>
            <TabHeader>
                <TabHeaderRF Horizontal=false TextSize="calc(10px + 1vw);" Text="Due Diligence" Icon="fa-solid fa-3" IconSize="calc(10px + 1vw);" />
            </TabHeader>
            <TabBody>
                <RowRF>

                    <ColRF SpanSM="12" Span="3" SpanL="3" SpanXL="3">
                        <InputRF @bind-Value="@context.Venue" Label="Venue" Placeholder="Enter Venue" />
                    </ColRF>


                </RowRF>
            </TabBody>
        </TabRF>
  
    </FormRF>
</PageRF>
@code
{
    Db db { get; set; }
    FormRF<Training> formRF { get; set; }

    protected override void OnInitialized()
    {
        db = new Db(config);
    }


    void afterSave(Training model)
    {
        formRF?.Reset();
        nav.NavigateTo($"/TrainingCategoryList");

    }


    string colorName = "#eeeeee";

    void close(int i)

    {

    }

    void open(int i)

    {

    }

    bool next(int i)

    {

        if (i == 3)

        {
            var data = formRF.Data;
            db.Save(data);
            db.Commit();

            RF.UI.Toaster.Success("OK");

        }

        return true;

    }

    void prev(int i)

    {

    }


}


